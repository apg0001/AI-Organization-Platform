{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Organization",
  "version": "0.2.0",
  "identifier": "io.github.apg0001.ai-organization",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Organization",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#0e1015"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/ai-org-server"],
    "resources": { "../../../LICENSE": "LICENSE", "../../../NOTICE": "NOTICE", "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md" },
    "license": "Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "AI 회사를 설계하고 Claude Code 에이전트에게 일을 맡기는 로컬 앱",
    "longDescription": "조직도로 AI 에이전트 팀을 만들고, 이 컴퓨터의 Claude Code로 실제 작업을 위임합니다. 시스템 트레이에서 실행 상태·승인 대기·사용량을 보고 알림을 받습니다."
  }
}
