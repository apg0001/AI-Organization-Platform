# AI Organization Platform 환경 변수 예시. 비밀 값은 없다(이 앱은 API 키를 받지 않는다).
# 백엔드는 이 파일을 자동으로 읽지 않는다. 셸에서 export 하거나 scripts/dev.sh 앞에 붙여 쓴다.

# 로그인 보호(on/off). off면 루프백·Host·Origin 검사만 남는다(테스트·혼자 쓰는 컴퓨터).
AI_ORG_AUTH=on

# 데이터 디렉터리(SQLite DB, 업로드, 에이전트 전용 작업 폴더). 기본: ~/.ai-org
AI_ORG_HOME=~/.ai-org
# 백엔드 바인딩. 루프백 외 주소는 거부한다.
AI_ORG_HOST=127.0.0.1
AI_ORG_PORT=8000
# 웹 개발 서버 포트(백엔드 Origin 허용 목록에도 쓰인다)
AI_ORG_WEB_PORT=3000
# 웹 개발 서버가 프록시할 백엔드 주소
AI_ORG_API_URL=http://127.0.0.1:8000
# Claude Code 설정 디렉터리(Skills·MCP·Plugins를 읽기 전용으로 탐색)
AI_ORG_CLAUDE_HOME=~/.claude
# Claude Code 실행 파일 이름 또는 경로
AI_ORG_CLAUDE_BIN=claude
# 동시에 실행할 Claude Code 프로세스 수(메모리에 맞게)
AI_ORG_MAX_RUNS=2
# 에이전트 한 턴의 최대 에이전트 루프 횟수
AI_ORG_MAX_TURNS=30
# 사용자 승인 대기 시간(초). 지나면 거부로 처리
AI_ORG_APPROVAL_TIMEOUT=900

# 테스트용 가짜 런타임(E2E 전용). 운영에서는 설정하지 않는다.
# AI_ORG_RUNTIME=fake

# 주의: ANTHROPIC_API_KEY가 환경에 있으면 Claude Code가 CLI 로그인 대신 API 키 과금을 쓴다.
